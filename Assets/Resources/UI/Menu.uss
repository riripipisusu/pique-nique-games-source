/* Design "Pique-Nique's Games" (Claude Design) : contours #2E1B10, plaques creme, boutons gel.
   Polices : Fredoka (texte), Fredoka Bold (boutons), Lilita One (titres). */
.root {
    flex-grow: 1;
    -unity-font: url("../Fonts/Fredoka.ttf");
    -unity-font-definition: initial;
    color: rgb(59, 36, 22);
}

.screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    opacity: 0;
    translate: 0 24px;
    transition-property: opacity, translate;
    transition-duration: 0.3s, 0.3s;
    transition-timing-function: ease-out-cubic;
}
.screen.in { opacity: 1; translate: 0 0; }
.hidden { display: none; }
.dim { background-color: rgba(20, 24, 40, 0.55); }

/* ---------- Ecran titre (le pique-nique 3D reste visible a droite) ---------- */
.title-screen { justify-content: flex-start; align-items: flex-start; padding-left: 110px; padding-top: 60px; }
.logo-box { rotate: -3deg; align-items: center; }
.logo {
    -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial;
    font-size: 132px; color: #FFC46B; margin: -10px 0;
    -unity-text-outline-width: 5px; -unity-text-outline-color: #2E1B10;
    text-shadow: 0 9px 0 #2E1B10;
    -unity-text-align: middle-center;
}
.logo2 { font-size: 104px; color: #A6E86F; }
.tagline {
    -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial;
    font-size: 32px; color: #FFFFFF; margin: 18px 0 44px 6px;
    -unity-text-outline-width: 1.5px; -unity-text-outline-color: #1E5410; text-shadow: 0 3px 0 #1E5410;
}
.menu-col { width: 600px; }
.menu-row { flex-direction: row; margin: 0 -9px; }
.menu-row > Button { flex-grow: 1; flex-basis: 0; }
.menu-row > Button.gl { margin-left: 9px; margin-right: 9px; }
.corner { position: absolute; top: 28px; right: 32px; flex-direction: row; }
.corner > Button.gl.round { margin: 0 0 0 16px; }
Button.gl.profile { position: absolute; left: 64px; bottom: 76px; height: 108px; }
Button.gl.profile .gl-face { padding: 0 30px 0 14px; justify-content: flex-start; }
.profile-sub { font-size: 18px; color: #6E4C31; -unity-font: url("../Fonts/Fredoka-SemiBold.ttf"); -unity-font-definition: initial; }
.profile-name {
    font-size: 32px; color: #2C62C9; margin-top: -4px;
    -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial;
    -unity-text-outline-width: 2px; -unity-text-outline-color: #2E1B10;
}
.profile .portrait { border-color: #2C62C9; border-width: 5px; margin-right: 16px; }
.version {
    position: absolute; right: 40px; bottom: 44px; font-size: 22px; color: #FFFFFF;
    -unity-font: url("../Fonts/Fredoka-SemiBold.ttf"); -unity-font-definition: initial;
    -unity-text-outline-width: 3px; -unity-text-outline-color: #1E5410;
}
.credits {
    position: absolute; bottom: 14px; left: 64px; right: 300px;
    font-size: 15px; color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.7); white-space: normal;
}

/* ---------- Boutons gel ---------- */
Button.btn {
    -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial;
    color: #FFFFFF;
    transition-property: scale, translate, padding-bottom, opacity;
    transition-duration: 0.12s;
}
Button.btn:disabled { opacity: 0.45; }
Button.gl {
    height: 88px; margin: 9px 0; padding: 0 0 10px 0;
    border-width: 4px; border-radius: 22px;
}
Button.gl, Button.gl:hover, Button.gl:active, Button.gl:hover:active { background-color: #D9660C; border-color: #2E1B10; }
Button.gl:hover { scale: 1.04 1.04; }
Button.gl:active { translate: 0 7px; padding-bottom: 3px; scale: 1 1; }
.gl-face {
    flex-grow: 1; flex-direction: row; align-items: center; justify-content: center;
    padding: 0 30px; border-radius: 18px; overflow: hidden;
    background-color: #FF9B2F; border-top-width: 4px; border-color: #FFC46B;
}
.gl-shine { position: absolute; left: 8px; right: 8px; top: 3px; height: 36%; border-radius: 40px; background-color: rgba(255, 255, 255, 0.3); }
Button.gl:hover .gl-shine { background-color: rgba(255, 255, 255, 0.48); }
.gl-label {
    font-size: 32px; color: #FFFFFF; white-space: nowrap; -unity-text-align: middle-center; margin: 0; padding: 0;
    -unity-text-outline-width: 3px; -unity-text-outline-color: #7A3300; text-shadow: 0 3px 0 #7A3300;
}
.gl-ico { width: 38px; height: 38px; margin-right: 14px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }

Button.gl.green, Button.gl.green:hover, Button.gl.green:active, Button.gl.green:hover:active { background-color: #3A8C22; }
Button.gl.green .gl-face { background-color: #5CC23A; border-color: #A6E86F; }
Button.gl.green .gl-label { -unity-text-outline-color: #1E5410; text-shadow: 0 3px 0 #1E5410; }
Button.gl.blue, Button.gl.blue:hover, Button.gl.blue:active, Button.gl.blue:hover:active { background-color: #1C6FC4; }
Button.gl.blue .gl-face { background-color: #3AA7F2; border-color: #8FD6FF; }
Button.gl.blue .gl-label { -unity-text-outline-color: #0D3A73; text-shadow: 0 3px 0 #0D3A73; }
Button.gl.red, Button.gl.red:hover, Button.gl.red:active, Button.gl.red:hover:active { background-color: #B82A1D; }
Button.gl.red .gl-face { background-color: #F0503E; border-color: #FF8C7C; }
Button.gl.red .gl-label { -unity-text-outline-color: #6B120A; text-shadow: 0 3px 0 #6B120A; }
Button.gl.ghost, Button.gl.ghost:hover, Button.gl.ghost:active, Button.gl.ghost:hover:active { background-color: #E2C391; }
Button.gl.ghost .gl-face { background-color: #FFF1D6; border-color: #FFFFFF; }
Button.gl.ghost .gl-label { color: #5A3A1E; -unity-text-outline-width: 0; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
Button.gl.ghost .gl-ico { -unity-background-image-tint-color: #2E1B10; }

Button.gl.small { height: 66px; margin: 5px 0; padding-bottom: 7px; border-radius: 18px; }
Button.gl.small:active { padding-bottom: 2px; translate: 0 5px; }
Button.gl.small .gl-face { padding: 0 22px; border-radius: 14px; }
Button.gl.small .gl-label { font-size: 24px; }
Button.gl.small .gl-ico { width: 28px; height: 28px; margin-right: 10px; }
Button.gl.lg { height: 112px; }
Button.gl.lg .gl-face { padding: 0 48px; }
Button.gl.lg .gl-label { font-size: 42px; -unity-text-outline-width: 4px; text-shadow: 0 4px 0 #7A3300; }
Button.gl.lg .gl-ico { width: 48px; height: 48px; margin-right: 18px; }
Button.gl.round { width: 88px; height: 88px; margin: 0; border-radius: 44px; }
Button.gl.round .gl-face { padding: 0; border-radius: 40px; }
Button.gl.round .gl-ico { margin: 0; }
Button.gl.round .gl-label { display: none; }
Button.gl.square { width: 66px; }
Button.gl.square .gl-face { padding: 0; }
Button.gl.filter { margin-right: 14px; }

/* ---------- Panneaux : cadre vert + plaque creme, titre en ruban orange ---------- */
.frame {
    background-color: #5CC23A; border-width: 6px; border-bottom-width: 12px; border-color: #2E1B10;
    border-radius: 46px; padding: 22px;
}
.panel {
    background-color: #FFF6E3;
    border-radius: 30px;
    border-width: 5px;
    border-color: #2E1B10;
    padding: 34px 44px;
}
.frame > .panel { padding-top: 40px; }
.panel-title {
    -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial;
    align-self: center; margin: -112px 0 14px 0; padding: 4px 56px 8px 56px;
    font-size: 60px; color: #FFFFFF; -unity-text-align: middle-center;
    -unity-text-outline-width: 4px; -unity-text-outline-color: #7A3300; text-shadow: 0 4px 0 #7A3300;
    background-color: #FF9B2F; border-radius: 60px;
    border-width: 5px; border-bottom-width: 12px; border-color: #2E1B10;
}
.panel-title.win-title { font-size: 84px; }
.h2 { font-size: 32px; -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial; margin: 16px 0 8px 0; color: #2E1B10; }
.p { font-size: 25px; white-space: normal; margin-bottom: 8px; }
.muted { font-size: 24px; color: #6E4C31; }
.row { flex-direction: row; align-items: center; }
.spread { justify-content: space-between; }
.grow { flex-grow: 1; }
.bottom-row { margin-top: 20px; }
.bottom-row > Button.gl { margin-right: 14px; }

/* ---------- Nouvelle partie ---------- */
.mode-card {
    flex-grow: 1; flex-basis: 0;
    min-height: 150px;
    margin: 0 8px;
    padding: 16px 22px;
    border-radius: 22px;
    border-width: 4px;
    border-bottom-width: 10px;
    border-color: #2E1B10;
    background-color: #FFF1D6;
    align-items: flex-start;
    justify-content: flex-start;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.15s;
}
.mode-card:hover { scale: 1.02 1.02; background-color: #FFF8EA; }
.mode-card.selected { border-color: #D9660C; background-color: #FFE0A8; }
.mode-name { font-size: 34px; -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial; color: #2E1B10; }
.mode-desc { font-size: 21px; white-space: normal; color: #6E4C31; margin-top: 6px; -unity-text-align: upper-left; }
.mode-name { -unity-text-align: upper-left; }
.setting .bet-label { margin: 0 14px; }

.player-row {
    flex-direction: row; align-items: center; margin: 6px 0; padding: 8px 14px;
    border-radius: 22px; border-width: 4px; border-color: #2E1B10; background-color: #F7E7C8;
}
.chip { width: 44px; height: 44px; border-radius: 22px; border-width: 4px; border-color: #2E1B10; margin-right: 14px; }
TextField.name-field { flex-grow: 1; margin: 0; }
TextField.name-field > .unity-text-field__input {
    font-size: 28px; height: 60px; padding: 0 18px;
    border-radius: 16px; border-width: 4px; border-color: #2E1B10;
    background-color: #FFFFFF; color: #2E1B10;
}
TextField.name-field:focus > .unity-text-field__input { border-color: #3AA7F2; }

/* ---------- Parametres ---------- */
.settings-panel { width: 1240px; height: 820px; }
.tabs { flex-direction: row; justify-content: center; margin-bottom: 16px; }
Button.tab, Button.tab:hover, Button.tab:active {
    -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial;
    font-size: 26px; height: 62px; margin: 0 7px; padding: 0 28px;
    border-radius: 18px; border-width: 4px; border-bottom-width: 9px; border-color: #2E1B10;
    background-color: #FFF1D6; color: #5A3A1E;
}
Button.tab:hover { background-color: #FFFFFF; }
Button.tab.selected, Button.tab.selected:hover {
    background-color: #3AA7F2; color: #FFFFFF; border-bottom-color: #1C6FC4;
    -unity-text-outline-width: 2px; -unity-text-outline-color: #0D3A73;
}
.settings-scroll { flex-grow: 1; margin-bottom: 14px; }
.setting {
    flex-direction: row; align-items: center; justify-content: space-between;
    min-height: 74px; padding: 0 22px; margin: 5px 0;
    border-radius: 18px; background-color: #F7E7C8;
}
.setting-label { font-size: 27px; -unity-font: url("../Fonts/Fredoka-SemiBold.ttf"); -unity-font-definition: initial; }
.setting-field { width: 480px; margin: 0; }
.value { font-size: 24px; width: 86px; -unity-text-align: middle-right; color: #D9660C; -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial; }

DropdownField > .unity-base-popup-field__input,
.unity-base-dropdown__container-outer {
    font-size: 24px; height: 54px; padding: 0 16px;
    border-radius: 16px; border-width: 4px; border-color: #2E1B10;
    background-color: #FFFFFF; color: #2E1B10;
}
.unity-base-dropdown__label { font-size: 24px; }
.unity-base-dropdown__item { height: 42px; }

Slider { flex-grow: 1; margin: 0; }
Slider .unity-base-slider__tracker {
    height: 20px; margin-top: -10px; border-radius: 10px;
    background-color: #FFF1D6; border-width: 4px; border-color: #2E1B10;
}
Slider .unity-base-slider__dragger {
    width: 40px; height: 40px; margin-top: -20px; border-radius: 20px;
    background-color: #3AA7F2; border-width: 4px; border-color: #2E1B10;
}
Toggle .unity-toggle__checkmark {
    width: 48px; height: 48px; border-radius: 14px;
    border-width: 4px; border-color: #2E1B10;
    background-color: #FFFFFF;
    -unity-background-image-tint-color: #FFFFFF;
}
Toggle:checked .unity-toggle__checkmark { background-color: #5CC23A; }

/* ---------- Salon ---------- */
.lobby-cols { align-items: stretch; }
.lobby-left { flex-grow: 1; flex-basis: 0; margin-right: 44px; }
.lobby-right { width: 560px; }
.lobby-list { height: 520px; }
.lobby-name {
    font-size: 32px; margin: 0 16px 0 6px;
    -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial;
    -unity-text-outline-width: 2px; -unity-text-outline-color: #2E1B10;
}
.pill {
    font-size: 20px; color: #FFFFFF; padding: 2px 14px; margin-right: 8px; border-radius: 16px;
    border-width: 3px; border-color: #2E1B10;
    -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial;
    -unity-text-outline-width: 1.5px; -unity-text-outline-color: #2E1B10;
}
.pill-gold { background-color: #FFC72C; }
.pill-blue { background-color: #3AA7F2; }
.code {
    flex-grow: 1; height: 92px; margin: 5px 16px 5px 0; padding: 0 20px;
    font-size: 64px; letter-spacing: 12px; color: #2E1B10; -unity-text-align: middle-center;
    -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial;
    background-color: #FFFFFF; border-radius: 20px; border-width: 5px; border-color: #2E1B10;
}
.lobby-game {
    margin: 24px 0 12px 0; padding: 14px; border-radius: 24px; border-width: 4px; border-color: #2E1B10; background-color: #F7E7C8;
}
.lobby-art {
    width: 200px; height: 111px; margin-right: 18px; border-radius: 14px; border-width: 4px; border-color: #2E1B10;
    -unity-background-scale-mode: scale-and-crop;
}
.lobby-options .mode-card { min-height: 0; padding: 10px 14px; margin: 0 4px; border-bottom-width: 8px; }
.lobby-options .mode-name { font-size: 24px; }
.lobby-options .mode-desc { font-size: 16px; }
.status { color: #D9660C; min-height: 34px; margin: 0 12px 0 0; flex-shrink: 1; }

/* ---------- HUD ---------- */
.hud { justify-content: flex-start; align-items: stretch; }
.players-bar { flex-direction: row; justify-content: flex-start; margin: 28px 0 0 40px; }
.pcard {
    flex-direction: row; align-items: center;
    margin: 0 14px 0 0; padding: 8px 18px 8px 10px;
    border-radius: 22px; border-width: 4px; border-bottom-width: 8px; border-color: #2E1B10;
    background-color: #FFF6E3;
    transition-property: scale, translate; transition-duration: 0.25s;
}
.pcard.active { scale: 1.08 1.08; translate: 0 4px; border-color: #FF9B2F; }
.pname {
    font-size: 28px; margin: 0 12px 0 4px;
    -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial;
    -unity-text-outline-width: 2px; -unity-text-outline-color: #2E1B10;
}
.pip {
    width: 34px; height: 34px; margin: 0 3px; border-radius: 17px; border-width: 3px;
    border-color: #2E1B10; background-color: #E2C391;
    font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-center; color: #2E1B10;
}
.pip.field { background-color: #FFFFFF; }

.action {
    position: absolute; bottom: 20px; left: 50%; translate: -50% 0;
    flex-direction: row; align-items: center;
    padding: 14px 26px 16px 18px;
}
.action-col { align-items: center; }
.turn { font-size: 28px; -unity-text-align: middle-center; margin-bottom: 2px; }
.card {
    width: 110px; height: 148px; margin: 0 22px 0 0;
    border-radius: 18px; border-width: 5px; border-bottom-width: 10px; border-color: #2E1B10;
    background-color: #FFF6E3;
    align-items: center; justify-content: center;
    scale: 1 1; rotate: 0deg;
    transition-property: scale, rotate; transition-duration: 0.35s; transition-timing-function: ease-out-back;
}
.card.flip { scale: 0 1; rotate: -8deg; }
.card.carrot-card { background-color: #FF9B2F; }
.card-value {
    font-size: 78px; color: #FF9B2F; -unity-text-align: middle-center;
    -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial;
    -unity-text-outline-width: 4px; -unity-text-outline-color: #2E1B10; text-shadow: 0 4px 0 #2E1B10;
}
.card.carrot-card .card-value { font-size: 26px; color: #FFFFFF; text-shadow: 0 2px 0 #2E1B10; -unity-text-outline-width: 3px; }
.card-sub { font-size: 16px; color: #6E4C31; -unity-text-align: middle-center; white-space: normal; }
.card.carrot-card .card-sub { color: #FFFFFF; }
.rabbit-row { flex-direction: row; justify-content: center; }
.rabbit-row Button.gl { width: 180px; height: 80px; margin: 4px 6px; }
.rabbit-row .gl-face { padding: 0 8px; }
.rabbit-row .gl-label { font-size: 22px; white-space: normal; }
.deck { font-size: 17px; color: #6E4C31; margin-top: 2px; }

.feed { position: absolute; bottom: 26px; left: 30px; width: 560px; align-items: flex-start; }
.feed-line {
    font-size: 21px; white-space: normal; margin: 4px 0; padding: 5px 18px; color: #3B2416;
    background-color: #FFF6E3; border-radius: 20px; border-width: 3px; border-color: #2E1B10; opacity: 0.85;
}
.feed-line.last { opacity: 1; -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial; }

.cycle { position: absolute; top: 140px; right: 26px; width: 420px; padding: 20px 24px; }
.cycle-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 6px; }
.cell {
    width: 66px; height: 58px; margin: 3px; border-radius: 12px; border-width: 3px;
    border-color: #E2C391; background-color: #F7E7C8;
    font-size: 24px; -unity-font-style: bold; -unity-text-align: middle-center; color: #B09070;
}
.cell.known { background-color: #FFFFFF; color: #2E1B10; }
.cell.next { border-color: #B82A1D; background-color: #FFC8BE; color: #6B120A; }
.cell.now { border-color: #2E1B10; background-color: #FF9B2F; color: #FFFFFF; }
.small-note { font-size: 19px; color: #6E4C31; white-space: normal; margin-top: 8px; }

.banner-row { position: absolute; top: 170px; left: 0; right: 0; align-items: center; }
.banner {
    -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial;
    font-size: 64px; -unity-text-align: middle-center; color: #FFFFFF; padding: 6px 60px 10px 60px;
    -unity-text-outline-width: 4px; -unity-text-outline-color: #7A3300; text-shadow: 0 5px 0 #7A3300;
    background-color: #FF9B2F; border-radius: 70px; border-width: 5px; border-bottom-width: 14px; border-color: #2E1B10;
    opacity: 0; scale: 0.6 0.6;
    transition-property: opacity, scale; transition-duration: 0.3s; transition-timing-function: ease-out-back;
}
.banner.show { opacity: 1; scale: 1 1; }
.hint {
    position: absolute; bottom: 12px; right: 26px; font-size: 19px;
    color: #FFFFFF; -unity-text-outline-width: 1px; -unity-text-outline-color: #2E1B10;
}

/* ---------- Multi-jeux ---------- */
.layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.game-row { align-items: stretch; margin: 26px 0 24px 0; }
.game-card {
    width: 312px; flex-shrink: 1; min-width: 0; margin: 0 8px; padding: 0;   /* 6 jeux et plus : les cartes se serrent */
    border-radius: 26px; border-width: 5px; border-bottom-width: 12px; border-color: #2E1B10;
    background-color: #FFF1D6; align-items: stretch; justify-content: flex-start; overflow: hidden;
    transition-property: scale, translate, border-color; transition-duration: 0.15s;
}
.game-card:hover { background-color: #FFF1D6; scale: 1.04 1.04; translate: 0 -6px; border-color: #D9660C; }
.game-art { height: 173px; border-bottom-width: 5px; border-color: #2E1B10; -unity-background-scale-mode: scale-and-crop; }
.game-txt { padding: 14px 18px 18px 18px; }
.game-card .mode-name, .game-card .mode-desc, .game-card .game-meta { -unity-text-align: upper-center; }
.game-card .mode-name { font-size: 28px; white-space: normal; }
.game-meta { font-size: 20px; color: #6E4C31; -unity-font: url("../Fonts/Fredoka-SemiBold.ttf"); -unity-font-definition: initial; }
.game-card .mode-desc { font-size: 18px; }

.portrait {
    border-radius: 50%; border-width: 4px; border-color: rgb(91, 58, 34);
    background-color: rgb(214, 234, 248); -unity-background-scale-mode: scale-and-crop;
    padding: 0; margin: 0 10px 0 0;
}
Button.portrait:hover { scale: 1.08 1.08; border-color: rgb(240, 138, 36); }
.avatar-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.avatar-cell { width: 160px; align-items: center; margin: 8px 4px; }
.avatar-cell .portrait { margin: 0; }
.avatar-name { font-size: 17px; -unity-text-align: middle-center; white-space: normal; margin-top: 4px; }

.chips { font-size: 22px; -unity-font-style: bold; color: rgb(31, 107, 62); padding: 4px 12px; border-radius: 14px; background-color: rgb(226, 243, 214); }
.chips.broke { color: rgb(160, 60, 40); background-color: rgb(250, 220, 210); }
.round-label {
    position: absolute; top: 108px; left: 0; right: 0; -unity-text-align: middle-center;
    font-size: 30px; -unity-font-style: bold; color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(60, 40, 20);
}
.bet-label { font-size: 30px; -unity-font-style: bold; color: rgb(240, 138, 36); }
Button.chip-btn { width: 96px; height: 96px; border-radius: 48px; padding: 0; font-size: 24px; margin: 4px 6px; border-width: 6px; border-color: rgb(255, 255, 255); }
Button.chip-10 { background-color: rgb(216, 66, 58); }
Button.chip-50 { background-color: rgb(47, 111, 214); }
Button.chip-100 { background-color: rgb(43, 43, 43); }
Button.chip-500 { background-color: rgb(138, 79, 208); }
.bubbles { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.bubble {
    position: absolute; translate: -50% -100%;
    font-size: 22px; -unity-font-style: bold; padding: 4px 14px; border-radius: 16px;
    background-color: rgba(255, 247, 229, 0.95); color: rgb(74, 46, 23);
    border-width: 2px; border-bottom-width: 5px; border-color: rgb(91, 58, 34);
}

/* ---------- Blackjack façon casino ---------- */
.bj-turn {
    position: absolute; top: 24px; left: 0; right: 0; -unity-text-align: middle-center;
    font-size: 34px; -unity-font-style: bold; color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(20, 12, 8);
}
.bj-side { position: absolute; bottom: 110px; flex-direction: column-reverse; align-items: center; }
.bj-side.left { left: 40px; }
.bj-side.right { right: 40px; }
.round-action { align-items: center; margin: 10px 0; }
Button.round-act {
    width: 118px; height: 118px; border-radius: 59px; padding: 0; margin: 0;
    font-size: 44px; border-width: 6px; border-bottom-width: 6px; border-color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);
}
Button.round-act.act-red { background-color: rgb(214, 48, 49); }
Button.round-act.act-green { background-color: rgb(76, 175, 80); }
Button.round-act.act-blue { background-color: rgb(52, 120, 200); }
Button.round-act:hover { scale: 1.08 1.08; }
Button.round-act:disabled { opacity: 0.35; }
.round-label-txt {
    font-size: 20px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-top: 4px;
    -unity-text-outline-width: 1.5px; -unity-text-outline-color: rgb(0, 0, 0);
}
.bj-bet {
    position: absolute; bottom: 90px; left: 50%; translate: -50% 0; align-items: center;
    padding: 12px 26px; border-radius: 26px; background-color: rgba(10, 20, 14, 0.78);
    border-width: 3px; border-color: rgb(217, 178, 90);
}
.bj-bet .bet-label { color: rgb(255, 222, 140); }
Button.chip-btn {
    width: 92px; height: 92px; border-radius: 46px; padding: 0; margin: 4px 6px;
    border-width: 0; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit;
}
Button.chip-btn:hover { scale: 1.12 1.12; translate: 0 -4px; }
.bj-bar {
    position: absolute; bottom: 0; left: 0; right: 0; height: 64px;
    flex-direction: row; justify-content: space-around; align-items: center;
    background-color: rgba(8, 6, 5, 0.85); border-top-width: 2px; border-color: rgb(217, 178, 90);
}
.bar-item { font-size: 26px; color: rgb(240, 225, 190); }
.seat-tag {
    position: absolute; translate: -50% 0; flex-direction: row; align-items: center;
    padding: 6px 16px 6px 6px; border-radius: 40px; background-color: rgba(10, 8, 6, 0.8);
    border-width: 2px; border-color: rgb(217, 178, 90);
}
.seat-tag.active { border-color: rgb(255, 240, 150); scale: 1.08 1.08; background-color: rgba(60, 45, 10, 0.9); }
.seat-tag .portrait { margin-right: 10px; }
.seat-name { font-size: 20px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.seat-chips { font-size: 20px; color: rgb(255, 214, 120); }
.bubble.badge {
    background-color: rgba(15, 15, 15, 0.88); color: rgb(255, 255, 255);
    border-width: 0; border-bottom-width: 4px; border-radius: 10px; font-size: 24px; padding: 2px 12px;
}



.bj-bet { left: auto; right: 34px; bottom: 90px; translate: 0 0; width: 250px; }
.bj-bet .rabbit-row { flex-direction: row; flex-wrap: wrap; justify-content: center; }


.update-card { position: absolute; top: 40px; right: 40px; width: 420px; align-items: center; padding: 20px 26px; }
.update-card .p { -unity-text-align: middle-center; }

/* --- Roulette --------------------------------------------------------------------- */

.rt-panel {
    position: absolute; bottom: 16px; left: 50%; translate: -50% 0; flex-direction: row; align-items: center;
    padding: 8px 18px; border-radius: 22px; background-color: rgba(10, 20, 14, 0.86);
    border-width: 3px; border-color: rgb(217, 178, 90);
}
.rt-panel > .row.spread { align-items: center; }
.rt-info { font-size: 24px; color: rgb(240, 225, 190); margin-right: 20px; }
Button.chip-btn.rt-chipbtn { width: 62px; height: 62px; border-radius: 31px; margin: 0 4px; }
Button.chip-btn.rt-chipbtn.rt-sel { scale: 1.18 1.18; translate: 0 -6px; }
.rt-board { position: relative; margin: 6px 0 8px 0; }
.rt-cell {
    position: absolute; align-items: center; justify-content: center;
    border-width: 1.5px; border-color: rgb(240, 225, 190); background-color: rgb(24, 98, 52);
}
.rt-cell.red { background-color: rgb(190, 32, 36); }
.rt-cell.black { background-color: rgb(26, 24, 24); }
.rt-cell.green { background-color: rgb(24, 128, 60); border-top-left-radius: 26px; border-bottom-left-radius: 26px; }
.rt-cell.red-chance { background-color: rgb(24, 98, 52); background-image: none; }
.rt-cell.red-chance > .rt-num, .rt-cell.black-chance > .rt-num { width: 34px; height: 34px; rotate: 45deg; }
.rt-cell.red-chance > .rt-num { background-color: rgb(190, 32, 36); }
.rt-cell.black-chance > .rt-num { background-color: rgb(26, 24, 24); }
.rt-cell.hl { border-color: rgb(255, 222, 120); border-width: 3px; background-color: rgb(214, 160, 40); }
.rt-cell:hover { border-color: rgb(255, 222, 120); }
.rt-num { font-size: 22px; -unity-font-style: bold; color: rgb(255, 250, 235); -unity-text-align: middle-center; }
.rt-spot { position: absolute; width: 18px; height: 18px; border-radius: 9px; background-color: rgba(255, 255, 255, 0); }
.rt-spot:hover { background-color: rgba(255, 222, 120, 0.9); }
.rt-chip {
    position: absolute; width: 34px; height: 34px; border-radius: 17px; -unity-text-align: middle-center;
    font-size: 14px; -unity-font-style: bold; color: rgb(40, 24, 10); background-color: rgb(255, 214, 90);
    border-width: 3px; border-color: rgb(255, 255, 255);
}
.rt-prison { position: absolute; bottom: 100%; left: 0; right: 0; -unity-text-align: middle-center; font-size: 20px; color: rgb(255, 180, 120); margin-bottom: 6px; }

.rt-tip {
    position: absolute; padding: 6px 12px; border-radius: 12px; font-size: 20px; color: rgb(255, 240, 200);
    background-color: rgba(10, 8, 6, 0.85); border-width: 2px; border-color: rgb(217, 178, 90);
}
.rt-players { position: absolute; top: 110px; left: 24px; }
.rt-player {
    flex-direction: row; align-items: center; margin-bottom: 10px; padding: 6px 18px 6px 6px;
    border-radius: 36px; background-color: rgba(10, 8, 6, 0.8); border-width: 2px; border-color: rgb(217, 178, 90);
}
.rt-player.active { border-color: rgb(255, 240, 150); background-color: rgba(60, 45, 10, 0.9); scale: 1.05 1.05; }
.rt-history { position: absolute; top: 150px; right: 44px; flex-direction: column; align-items: center; }
.rt-hist {
    width: 50px; height: 50px; border-radius: 25px; margin-bottom: 6px; -unity-text-align: middle-center;
    font-size: 22px; -unity-font-style: bold; color: rgb(255, 250, 235); border-width: 2px; border-color: rgb(217, 178, 90);
}
.rt-hist.red { background-color: rgb(190, 32, 36); }
.rt-hist.black { background-color: rgb(26, 24, 24); }
.rt-hist.green { background-color: rgb(24, 128, 60); }

/* --- Quiz d'images ------------------------------------------------------------------ */

.qz-top { position: absolute; top: 16px; left: 50%; translate: -50% 0; width: 760px; align-items: center; }
.qz-category {
    font-size: 30px; -unity-font-style: bold; color: rgb(255, 236, 170); padding: 6px 26px; border-radius: 22px;
    background-color: rgba(20, 10, 40, 0.8); border-width: 2px; border-color: rgb(255, 200, 58);
}
.qz-bar { width: 620px; height: 14px; margin-top: 10px; border-radius: 7px; background-color: rgba(20, 10, 40, 0.8); overflow: hidden; }
.qz-bar-fill { height: 100%; background-color: rgb(120, 220, 255); border-radius: 7px; }
.qz-bar-fill.hurry { background-color: rgb(255, 90, 90); }
.qz-timer { font-size: 26px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-top: 2px; -unity-text-outline-width: 1.5px; -unity-text-outline-color: rgb(0, 0, 0); }
.qz-board { position: absolute; top: 110px; right: 24px; width: 330px; padding: 14px 16px; }
.qz-row { flex-direction: row; align-items: center; margin: 4px 0; }
.qz-col { flex-grow: 1; }
.qz-score-bar { height: 8px; border-radius: 4px; background-color: rgba(0, 0, 0, 0.15); margin-top: 4px; overflow: hidden; }
.qz-score-fill { height: 100%; border-radius: 4px; }
.qz-board .seat-name { color: rgb(91, 58, 34); font-size: 22px; }
.qz-score { font-size: 26px; -unity-font-style: bold; margin-left: 10px; color: rgb(91, 58, 34); }
.qz-feed { position: absolute; top: 120px; left: 24px; width: 420px; }
.qz-feed-line {
    font-size: 22px; -unity-font-style: bold; margin-bottom: 6px; padding: 4px 12px; border-radius: 12px;
    background-color: rgba(15, 10, 25, 0.8); white-space: normal;
}
.qz-feed-line.found { background-color: rgba(20, 60, 30, 0.9); }
.qz-bottom { position: absolute; bottom: 24px; left: 50%; translate: -50% 0; width: 820px; align-items: center; }
.qz-status {
    font-size: 24px; -unity-font-style: bold; color: rgb(255, 245, 220); margin-bottom: 8px; padding: 4px 18px; border-radius: 16px;
    background-color: rgba(15, 10, 25, 0.85);
}
.qz-input { width: 820px; margin: 0; }
.qz-input > .unity-text-field__input {
    font-size: 32px; height: 64px; padding: 0 20px; border-radius: 32px; border-width: 4px; border-color: rgb(255, 200, 58);
    background-color: rgb(255, 250, 235); color: rgb(40, 24, 10);
}
.qz-input:disabled > .unity-text-field__input { background-color: rgb(210, 240, 215); border-color: rgb(80, 200, 110); }
.qz-tag {
    position: absolute; translate: -50% -50%; align-items: center; padding: 4px 14px; border-radius: 14px;
    background-color: rgba(15, 10, 25, 0.85); border-bottom-width: 4px;
}
.qz-tag-score { font-size: 20px; color: rgb(255, 222, 140); -unity-font-style: bold; }
.qz-bubble {
    position: absolute; translate: -50% -100%; max-width: 260px; font-size: 22px; -unity-font-style: bold; white-space: normal;
    padding: 6px 14px; border-radius: 16px; background-color: rgb(255, 250, 235); color: rgb(160, 40, 40);
    border-width: 3px; border-color: rgb(220, 70, 70); -unity-text-align: middle-center;
}
.qz-bubble.good { color: rgb(30, 120, 60); border-color: rgb(80, 200, 110); }
.qz-reveal { position: absolute; top: 120px; left: 50%; translate: -50% 0; align-items: center; padding: 14px 40px; min-width: 520px; }
.qz-reveal-title { font-size: 24px; color: rgb(140, 100, 70); }
.qz-answer { font-size: 44px; -unity-font-style: bold; color: rgb(240, 138, 36); -unity-text-align: middle-center; white-space: normal; max-width: 900px; }
.qz-credit { font-size: 18px; color: rgb(140, 100, 70); -unity-text-align: middle-center; white-space: normal; max-width: 900px; }

/* Ecran des pupitres du quiz (rendu dans une texture de 360 x 288) */
.pod {
    background-color: rgb(20, 78, 190); border-width: 10px; border-radius: 0; align-items: center; justify-content: space-between;
    background-image: none; padding: 6px 10px 8px 10px;
}
.pod-name { font-size: 44px; -unity-font-style: bold; color: rgb(255, 255, 255); margin: 0; -unity-text-align: middle-center; }
.pod-score { font-size: 96px; -unity-font-style: bold; color: rgb(255, 255, 255); margin: -18px 0 -14px 0; -unity-text-align: middle-center; }
.pod-band { width: 100%; height: 46px; border-radius: 23px; background-color: rgb(238, 242, 250); align-items: center; justify-content: center; }
.pod-band.found { background-color: rgb(190, 245, 205); }
.pod-strip { font-size: 34px; -unity-font-style: bold; margin: 0; -unity-text-align: middle-center; }

/* Generique TV Time */
.intro { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(0, 0, 0); }
.intro-video { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; }
.intro-skip { position: absolute; right: 30px; bottom: 20px; font-size: 20px; color: rgba(255, 255, 255, 0.55); }
.intro-ask { position: absolute; left: 50%; top: 50%; translate: -50% -50%; align-items: center; padding: 26px 40px; }
.intro-ask > .row { justify-content: center; }
.intro-ask Button { margin: 0 10px; }

/* Dialogue de Tenna (facon Deltarune : boite noire, liseré blanc) */
.dlg-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.dlg-box {
    position: absolute; left: 50%; bottom: 40px; translate: -50% 0; width: 1400px; min-height: 230px;
    padding: 22px 34px; background-color: rgb(0, 0, 0); border-width: 6px; border-color: rgb(255, 255, 255); border-radius: 4px;
}
.dlg-name { font-size: 26px; -unity-font-style: bold; color: rgb(255, 214, 90); margin: 0 0 8px 0; }
.dlg-text { font-size: 40px; color: rgb(255, 255, 255); white-space: normal; margin: 0; }
.dlg-hint { position: absolute; right: 24px; bottom: 10px; font-size: 30px; color: rgb(255, 255, 255); }
.dlg-skip { position: absolute; top: 28px; left: 40px; width: 280px; }

/* --- Le grand quiz de Tenna ------------------------------------------------------- */

.qz-choices { flex-direction: row; flex-wrap: wrap; justify-content: center; width: 1200px; }
Button.qz-choice {
    width: 580px; height: 66px; margin: 5px 8px; font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-left;
    padding-left: 24px; border-radius: 16px; color: rgb(255, 255, 255); border-width: 3px; border-color: rgb(255, 255, 255);
}
Button.qz-choice.choice-0 { background-color: rgb(214, 63, 90); }
Button.qz-choice.choice-1 { background-color: rgb(52, 120, 220); }
Button.qz-choice.choice-2 { background-color: rgb(236, 168, 30); }
Button.qz-choice.choice-3 { background-color: rgb(60, 170, 90); }
Button.qz-choice:disabled { opacity: 0.55; }
Button.qz-choice.good { border-color: rgb(255, 240, 120); border-width: 6px; opacity: 1; }
.qz-bottom { width: 1200px; }
/* Ecran geant : question ecrite (rendue en 1600 x 900) */
.tq { background-color: rgb(27, 16, 48); padding: 60px 80px; justify-content: center; align-items: center; }
.tq-text { font-size: 92px; -unity-font-style: bold; color: rgb(255, 255, 255); white-space: normal; -unity-text-align: middle-center; margin-bottom: 40px; }
.tq-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; width: 100%; }
.tq-prop {
    width: 47%; margin: 12px; padding: 22px 30px; font-size: 62px; -unity-font-style: bold; color: rgb(255, 255, 255);
    border-radius: 22px; white-space: normal; border-width: 4px; border-color: rgba(255, 255, 255, 0.5);
}
.tq-prop.choice-0 { background-color: rgb(214, 63, 90); }
.tq-prop.choice-1 { background-color: rgb(52, 120, 220); }
.tq-prop.choice-2 { background-color: rgb(236, 168, 30); }
.tq-prop.choice-3 { background-color: rgb(60, 170, 90); }
.tq-prop.good { border-color: rgb(255, 240, 120); border-width: 10px; }
.tq-answer { font-size: 80px; -unity-font-style: bold; color: rgb(255, 214, 90); margin-top: 30px; }

Button.chip-btn, Button.chip-btn:active, Button.chip-btn:hover { border-width: 0; background-color: rgba(0, 0, 0, 0); }
.bj-bet Button.gl.small { width: 200px; margin: 5px 0; }
.rt-panel Button.gl.small { width: 150px; margin: 0 5px; }
.rt-panel .gl-label { font-size: 21px; }
.rt-panel .gl-face { padding: 0 8px; }
Button.round-act, Button.qz-choice { color: #FFFFFF; -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial; }
.update-card { top: 136px; }


/* --- Choix du personnage ------------------------------------------------------------- */
.pick-scroll { flex-grow: 1; margin-bottom: 6px; }
.avatar-cell.selected .portrait { border-color: #FF9B2F; border-width: 7px; scale: 1.08 1.08; }
.pick-colors { padding: 10px 16px; border-radius: 20px; background-color: #F7E7C8; }
.pick-row { flex-wrap: wrap; }
.avatar-cell.pick-color { width: 84px; margin: 2px; }
.pick-name { font-size: 28px; margin-right: 24px; -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial; color: #2E1B10; }

/* Carte piochee de Croque-Carotte : l'illustration remplit la carte */
.action .card { width: 150px; height: 210px; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit; }

/* Grand quiz : familles de themes */
.theme-row { flex-wrap: wrap; }
Button.theme-chip, Button.theme-chip:hover, Button.theme-chip:active {
    font-size: 21px; height: 48px; margin: 4px 8px 4px 0; padding: 0 18px; border-radius: 24px;
    border-width: 3px; border-bottom-width: 6px; border-color: #2E1B10; background-color: #FFF1D6; color: #6E4C31;
    -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial;
}
Button.theme-chip.selected, Button.theme-chip.selected:hover { background-color: #F03C92; color: #FFFFFF; border-bottom-color: #B3145F; }
.lobby-themes Button.theme-chip { font-size: 17px; height: 40px; padding: 0 12px; }

/* Ecran du grand quiz : sujet de la question, anecdote apres la reponse */
.tq-topic { font-size: 54px; color: #FF8CC6; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 18px; white-space: normal; }
.tq-answer { margin-top: 26px; font-size: 70px; }
.tq-fact { font-size: 40px; color: #D9C6F0; -unity-text-align: middle-center; white-space: normal; margin-top: 12px; max-width: 1400px; }

.tq { padding: 40px 70px; }
.tq-topic { font-size: 44px; margin-bottom: 10px; }
.tq-text { font-size: 76px; margin-bottom: 24px; flex-shrink: 0; }
.tq-grid { flex-shrink: 0; }
.tq-prop { font-size: 52px; padding: 14px 26px; margin: 8px; flex-shrink: 0; }
.tq-fact { font-size: 34px; margin-top: 16px; }

/* Salon : choix du jeu par l'hote, pastilles en partie / spectateur */
.lobby-pick { flex-wrap: wrap; margin: 14px 0 4px 0; }
Button.pick-game, Button.pick-game:hover, Button.pick-game:active {
    width: 100px; height: 56px; margin: 0 8px 8px 0; padding: 0; border-radius: 12px; border-width: 4px; border-color: #2E1B10;
    -unity-background-scale-mode: scale-and-crop; background-color: #F7E7C8;
}
Button.pick-game:hover { scale: 1.06 1.06; }
Button.pick-game.selected { border-color: #FF9B2F; border-width: 6px; scale: 1.08 1.08; }
.pill-green { background-color: #5CC23A; }
.pill-grey { background-color: #9A8F8A; }
.lobby-right .muted { white-space: normal; font-size: 20px; }

/* Salon : tout tient dans l'ecran (titre visible, pas de chevauchement) */
.lobby-list { height: 360px; }
.lobby-game { margin: 12px 0 8px 0; padding: 10px; }
.lobby-game > VisualElement { flex-shrink: 1; flex-grow: 1; }
.lobby-game .mode-name { font-size: 28px; white-space: normal; }
.lobby-art { width: 150px; height: 84px; flex-shrink: 0; }
.lobby-pick { margin: 8px 0 0 0; }
.lobby-options .mode-card { min-height: 0; padding: 8px 10px; }
.lobby-options .mode-name { font-size: 19px; white-space: normal; }
.lobby-options .mode-desc { font-size: 15px; margin-top: 2px; }
.lobby-themes .h2 { margin: 8px 0 4px 0; font-size: 24px; }
.lobby-themes Button.theme-chip, .lobby-themes Button.theme-chip:hover, .lobby-themes Button.theme-chip:active { font-size: 16px; height: 36px; padding: 0 10px; margin: 3px 6px 3px 0; border-bottom-width: 5px; }
.lobby-right Button.gl.lg { height: 96px; margin-top: 10px; flex-shrink: 0; }
.lobby-right .code { height: 80px; font-size: 56px; }
/* Jeu de rythme : copie de l'interface du jeu d'origine (police 8bitoperator, couloir cyan au centre) */
.rh-title, .rh-num, .rh-lbl, .rh-combo, .rh-combo-text, .rh-gain, .rh-count, .rh-name, .rh-row-score, .rh-row-combo, .rh-offset, .rh-status, .rh-key {
    -unity-font: url("../Fonts/8bitoperator_jve.ttf"); -unity-font-definition: initial;
}
.rh-title {
    position: absolute; top: 22px; left: 0; right: 0; -unity-text-align: middle-center; font-size: 34px; color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);
}
.rh-progress { position: absolute; top: 70px; left: 50%; translate: -50% 0; width: 420px; height: 6px; background-color: rgba(255, 255, 255, 0.15); }
.rh-progress-fill { height: 100%; background-color: rgb(74, 215, 252); }
.rh-box { position: absolute; left: 50%; translate: -50% 0; top: 100px; width: 180px; height: 540px; }
.rh-track {
    flex-grow: 1; flex-direction: row; overflow: hidden; border-width: 5px; border-radius: 0;
    border-color: rgb(74, 215, 252); background-color: rgba(0, 0, 0, 0.86);
}
.rh-beat { position: absolute; left: 0; right: 0; height: 2px; margin-top: -1px; background-color: rgba(150, 150, 150, 0.35); }
.rh-lane { flex-grow: 1; width: 50%; }
/* Halo en degrade au-dessus de la cible (texture generee), allume a chaque note reussie et pendant une tenue */
.rh-flash {
    position: absolute; left: 6%; right: 6%; top: 0; height: 422px; opacity: 0;   /* du haut du couloir jusqu'a la cible */
    -unity-background-image-tint-color: rgb(74, 215, 252); -unity-background-scale-mode: stretch-to-fill;
    transition-property: opacity; transition-duration: 0.28s;
}
/* Halo seulement pendant une note tenue (sur les notes simples, les flashs qui s'enchainent genaient la lecture) */
.rh-lane.held .rh-flash { opacity: 0.8; transition-duration: 0.05s; }
.rh-lane.missed .rh-receptor { border-color: rgb(255, 70, 70); background-color: rgba(255, 60, 60, 0.35); }
.rh-lane.hit .rh-receptor { background-color: rgb(210, 250, 255); border-color: rgb(255, 255, 255); }
.rh-spark { position: absolute; width: 8px; height: 8px; background-color: rgb(200, 248, 255); }
.rh-receptor {
    position: absolute; left: 8%; right: 8%; top: 408px; height: 24px;
    border-width: 4px; border-color: rgb(74, 215, 252); background-color: rgba(0, 0, 0, 0.5);
}
.rh-lane.pressed .rh-receptor, .rh-lane.held .rh-receptor { background-color: rgba(74, 215, 252, 0.6); border-color: rgb(210, 250, 255); }
.rh-key { position: absolute; top: 452px; left: 0; right: 0; -unity-text-align: middle-center; font-size: 24px; color: rgba(255, 255, 255, 0.4); }
.rh-note { position: absolute; }
.rh-head { position: absolute; left: 0; right: 0; bottom: 0; height: 12px; background-color: rgb(74, 215, 252); }
.rh-stem { position: absolute; top: 0; bottom: 0; left: 50%; width: 10px; margin-left: -5px; background-color: rgb(74, 215, 252); display: none; }
.rh-note.rh-hold .rh-stem { display: flex; }
.rh-note.rh-holding .rh-head, .rh-note.rh-holding .rh-stem { background-color: rgb(220, 252, 255); }
.rh-note.rh-missed .rh-head, .rh-note.rh-missed .rh-stem { background-color: rgba(120, 120, 130, 0.6); }
.rh-combo {
    position: absolute; left: 0; right: 0; top: 140px; -unity-text-align: middle-center; font-size: 110px;
    color: rgba(255, 255, 255, 0.16);
}
.rh-combo-text { position: absolute; left: 0; right: 0; top: 250px; -unity-text-align: middle-center; font-size: 40px; color: rgba(255, 255, 255, 0.16); }
.rh-gain {
    position: absolute; top: 398px; width: 160px; font-size: 44px; color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);
    opacity: 1; translate: 0 0;
}
/* Reste lisible un moment, puis s'efface en montant (pas de transition au retour : la note suivante s'affiche net). */
.rh-gain.pop { opacity: 0; translate: 0 -24px; transition-property: opacity, translate; transition-duration: 0.6s; }
.rh-gain-left { right: 196px; -unity-text-align: middle-right; }
.rh-gain-right { left: 196px; -unity-text-align: middle-left; }
.rh-gain.perfect { color: rgb(255, 236, 110); }
.rh-gain.miss { color: rgb(255, 70, 70); }
.rh-scores { position: absolute; bottom: 26px; left: 50%; translate: -50% 0; width: 1180px; flex-direction: row; align-items: flex-end; }
.rh-pair { flex-direction: row; align-items: flex-end; }
.rh-num { font-size: 76px; -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(0, 0, 0); margin: 0 14px; }
.rh-lbl { font-size: 40px; margin-bottom: 10px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0); }
.rh-teal { color: rgb(0, 180, 182); }
.rh-cyan { color: rgb(74, 215, 252); }
.rh-board { position: absolute; top: 110px; right: 30px; width: 340px; padding: 10px 16px; background-color: rgba(0, 0, 0, 0.7); border-width: 3px; border-color: rgb(74, 215, 252); }
.rh-row { flex-direction: row; align-items: center; margin: 2px 0; }
.rh-name { font-size: 30px; }
.rh-row-combo { font-size: 24px; color: rgba(255, 255, 255, 0.55); margin-right: 12px; }
.rh-row-score { font-size: 30px; color: rgb(255, 255, 255); }
.rh-count {
    position: absolute; left: 0; right: 0; top: 34%; -unity-text-align: middle-center; font-size: 130px; color: rgb(255, 255, 255);
    -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(0, 0, 0);
}
.rh-offset {
    position: absolute; top: 660px; left: 0; right: 0; -unity-text-align: middle-center; font-size: 30px; color: rgb(255, 236, 110);
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0); opacity: 1;
}
.rh-offset.pop { opacity: 0; transition-property: opacity; transition-duration: 2.5s; }
.rh-status {
    position: absolute; bottom: 40px; left: 0; right: 0; -unity-text-align: middle-center; font-size: 34px; color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);
}
.rh-picker { flex-grow: 1; width: 100%; }
.rh-pick-head { align-items: center; margin-bottom: 8px; }
.rh-cover { width: 110px; height: 110px; margin-right: 18px; border-radius: 12px; border-width: 4px; border-color: #2E1B10; background-color: #2E1B10; -unity-background-scale-mode: scale-to-fit; }
.rh-tabs { flex-wrap: wrap; margin-bottom: 6px; }
.rh-tabs > Button { margin: 0 8px 6px 0; }
.rh-list { height: 250px; border-radius: 14px; background-color: rgba(46, 27, 16, 0.07); }
.rh-song {
    flex-direction: row; align-items: center; justify-content: space-between; margin: 3px 6px; padding: 6px 14px;
    border-radius: 10px; border-width: 3px; border-color: rgba(0, 0, 0, 0); background-color: #FFF8EA;
}
.rh-song:hover { background-color: #FFEFCC; }
.rh-song.selected { border-color: #D9660C; background-color: #FFE0A8; }
.rh-song-name { font-size: 22px; color: #2E1B10; -unity-font-style: bold; }
.rh-dif-easy { background-color: #5CC23A; }
.rh-dif-normal, .rh-dif-medium { background-color: #3AA7F2; }
.rh-dif-hard { background-color: #F29A2E; }
.rh-dif-veryhard { background-color: #E0463C; }
.rh-dif-impossible { background-color: #7A3CFF; }
/* Uno : main en bas, vignettes des joueurs, roue des couleurs, fin de manche */
.uno-top { position: absolute; top: 18px; left: 0; right: 0; align-items: center; }   /* toujours centre, quelle que soit la longueur du pseudo */
.uno-turn {
    font-size: 36px; -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial; color: rgb(255, 255, 255);
    -unity-text-outline-width: 2.5px; -unity-text-outline-color: #2E1B10; padding: 4px 26px; border-radius: 24px; background-color: rgba(46, 27, 16, 0.75);
}
.uno-color {
    margin-top: 8px; font-size: 22px; -unity-font-style: bold; color: rgb(255, 255, 255); padding: 3px 18px; border-radius: 16px;
    border-width: 3px; border-color: #2E1B10; -unity-text-outline-width: 1.5px; -unity-text-outline-color: #2E1B10;
}
.uno-hand { position: absolute; bottom: -70px; left: 330px; right: 330px; flex-direction: row; align-items: flex-end; justify-content: center; }
.uno-card {
    width: 176px; height: 271px; padding: 0; margin: 0; border-width: 0; border-radius: 14px; background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill; transition-property: translate, scale, opacity; transition-duration: 0.12s;
}
.uno-slot { transform-origin: 50% 100%; }
.uno-card:hover { translate: 0 -34px; scale: 1.06 1.06; background-color: rgba(0, 0, 0, 0); }
.uno-card.playable { translate: 0 -26px; }
.uno-card.playable:hover { translate: 0 -52px; }
.uno-status {
    position: absolute; bottom: 250px; left: 50%; translate: -50% 0; font-size: 24px; -unity-font-style: bold; color: rgb(255, 245, 220);
    padding: 4px 18px; border-radius: 16px; background-color: rgba(15, 10, 25, 0.8);
}
.uno-draw { position: absolute; right: 60px; bottom: 60px; }
.uno-call {
    position: absolute; right: 50px; bottom: 150px; width: 250px; height: 180px; padding: 0; margin: 0; border-width: 0;
    background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit;
}
.uno-call:hover { background-color: rgba(0, 0, 0, 0); scale: 1.08 1.08; }
.uno-catch {
    position: absolute; right: 50px; bottom: 350px; width: 250px; height: 180px; padding: 0; margin: 0; border-width: 0;
    background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit; align-items: center; justify-content: center;
}
.uno-catch:hover { background-color: rgba(0, 0, 0, 0); scale: 1.08 1.08; }
.uno-catch-band {
    rotate: -14deg; padding: 2px 22px; font-size: 38px; -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial; color: rgb(255, 255, 255);
    background-color: rgb(229, 50, 45); border-width: 4px; border-color: rgb(255, 255, 255); border-radius: 10px;
    -unity-text-outline-width: 2px; -unity-text-outline-color: #2E1B10;
}
.uno-catch-who {
    position: absolute; bottom: -18px; font-size: 20px; -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial; color: #2E1B10;
    background-color: #FFF6E3; border-width: 3px; border-color: #2E1B10; border-radius: 14px; padding: 2px 12px;
}
.uno-wheel-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.35); }
.uno-wheel { width: 380px; height: 380px; flex-direction: row; flex-wrap: wrap; border-radius: 190px; overflow: hidden; border-width: 8px; border-color: #2E1B10; }
.uno-quarter { width: 50%; height: 50%; margin: 0; padding: 0; border-width: 3px; border-color: #2E1B10; border-radius: 0; transition-property: scale; transition-duration: 0.1s; }
.uno-quarter:hover { scale: 1.06 1.06; }
.uno-wheel-title {
    margin-top: 18px; font-size: 34px; -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial; color: rgb(255, 255, 255);
    -unity-text-outline-width: 2.5px; -unity-text-outline-color: #2E1B10;
}
.uno-drawn { position: absolute; right: 60px; bottom: 170px; align-items: center; padding: 18px 26px; }
.uno-drawn-card { width: 120px; height: 185px; margin: 6px 0 12px 0; -unity-background-scale-mode: stretch-to-fill; }
.uno-round { position: absolute; top: 50%; left: 50%; translate: -50% -50%; width: 640px; }
.uno-gain { font-size: 22px; color: #1C7A3C; -unity-font-style: bold; margin-right: 16px; }
.uno-tag {
    position: absolute; flex-direction: row; align-items: center; padding: 6px 16px 6px 8px; border-radius: 40px;
    background-color: #FFF6E3; border-width: 4px; border-color: #2E1B10; transition-property: scale; transition-duration: 0.2s;
}
.uno-tag .portrait { margin: 0; }
.uno-tag-col { margin-left: 10px; }
.uno-tag-name { font-size: 24px; -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial; color: #2E1B10; }
.uno-tag-cards { align-items: center; margin-top: 2px; }
.uno-tag-card-icon { width: 20px; height: 28px; border-radius: 4px; background-color: #D8423A; border-width: 2px; border-color: #2E1B10; margin-right: 6px; rotate: -8deg; }
.uno-tag-count { font-size: 26px; -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial; color: #D9660C; }
.uno-tag.active { scale: 1.1 1.1; background-color: #FFE0A8; border-color: #D9660C; }
.uno-tag.uno-said .uno-tag-count { color: #E5322D; }
.uno-bubble {
    position: absolute; top: -20px; left: -30px; width: 190px; height: 190px; -unity-text-align: middle-center; font-size: 34px;
    -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial; color: rgb(229, 50, 45);
    -unity-text-outline-width: 2.5px; -unity-text-outline-color: rgb(255, 255, 255); -unity-background-scale-mode: stretch-to-fill;
    opacity: 1; scale: 1 1; transition-property: scale; transition-duration: 0.25s; transition-timing-function: ease-out-back;
}
.uno-bubble.burst { scale: 0.2 0.2; transition-duration: 0s; }
.uno-bubble.pop { opacity: 0; scale: 1.25 1.25; transition-property: opacity, scale; transition-duration: 0.5s; }
.uno-pulse { transition-property: scale; transition-duration: 0.45s; transition-timing-function: ease-in-out-sine; }
.uno-pulse.big { scale: 1.1 1.1; }
.uno-toast {
    font-size: 24px; -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial; color: #2E1B10;
    padding: 4px 18px; border-radius: 18px; background-color: #FFF6E3; border-width: 3px; border-color: #2E1B10; opacity: 1;
}
.uno-toast.hide { opacity: 0; transition-property: opacity; transition-duration: 0.4s; }
.uno-card.enter { translate: 0 320px; opacity: 0; }
.uno-card.entering { transition-duration: 0.35s; transition-timing-function: ease-out-back; }
.uno-round .seat-name { color: #2E1B10; font-size: 24px; -unity-font: url("../Fonts/Fredoka-Bold.ttf"); -unity-font-definition: initial; }
.uno-round { width: 760px; left: 50%; margin-left: -380px; translate: 0 -50%; }   /* largeur fixe : centrage exact */
.uno-round .panel-title { font-size: 40px; }
.uno-toast-row { position: absolute; bottom: 300px; left: 0; right: 0; align-items: center; }
.uno-challenge { position: absolute; left: 0; right: 0; top: 36%; align-items: center; padding: 18px 0; background-color: rgba(46, 27, 16, 0.55); }
.uno-challenge-text { font-size: 34px; -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial; color: rgb(255, 255, 255); -unity-text-outline-width: 2px; -unity-text-outline-color: #2E1B10; }
.uno-challenge-row { align-items: center; margin: 10px 0; }
.uno-challenge-card { width: 130px; height: 200px; margin: 0 40px; -unity-background-scale-mode: stretch-to-fill; rotate: -6deg; }
.uno-challenge-hint { font-size: 20px; color: rgb(255, 245, 220); -unity-font: url("../Fonts/Fredoka-SemiBold.ttf"); -unity-font-definition: initial; }
.uno-swap { position: absolute; top: 50%; left: 50%; width: 900px; margin-left: -450px; translate: 0 -50%; align-items: center; }
.uno-swap-list { flex-wrap: wrap; justify-content: center; }
.uno-swap-btn { width: 150px; margin: 8px; padding: 10px; align-items: center; border-radius: 20px; border-width: 4px; border-color: #2E1B10; background-color: #FFF6E3; }
.uno-swap-btn:hover { background-color: #FFE0A8; scale: 1.05 1.05; }
/* Uno : lueurs d'origine (cartes jouables, preparation du UNO) et popups facon jeu Uno (fond nuit, liseré doré) */
.uno-glow {
    position: absolute; left: -34px; right: -34px; top: -38px; bottom: -38px; translate: 0 -26px;
    -unity-background-scale-mode: stretch-to-fill; opacity: 1; transition-property: opacity; transition-duration: 0.45s;
}
.uno-glow.low { opacity: 0.45; }
.uno-call-glow {
    position: absolute; right: -20px; bottom: 105px; width: 390px; height: 270px; -unity-background-scale-mode: scale-to-fit;
    opacity: 1; transition-property: opacity; transition-duration: 0.45s;
}
.uno-call-glow.low { opacity: 0.5; }
.uno-popup {
    background-color: rgba(22, 16, 42, 0.9); border-radius: 26px; border-width: 4px; border-color: rgb(255, 196, 64);
    padding: 20px 30px;
}
.uno-popup .h2, .uno-popup .panel-title { color: rgb(255, 244, 214); -unity-text-outline-width: 1.5px; -unity-text-outline-color: rgb(46, 27, 16); }
.uno-popup.uno-challenge { left: 22%; right: 22%; }
.uno-popup.uno-swap { background-color: rgba(22, 16, 42, 0.92); }
/* Uno : logo "interdit" par-dessus la vignette d'un joueur qui passe son tour */
.uno-skip-mark {
    position: absolute; left: 50%; top: 50%; width: 130px; height: 130px; translate: -50% -50%; -unity-background-scale-mode: scale-to-fit;
    scale: 1 1; opacity: 1; transition-property: scale, opacity; transition-duration: 0.18s, 0.45s;
}
.uno-skip-mark.pop { scale: 0.2 0.2; opacity: 0; }
.uno-skip-mark.gone { opacity: 0; scale: 1.2 1.2; }

/* Petits chevaux : le plateau occupe le milieu de l'ecran -> panneau d'action en bas a droite, bandeau plus petit en haut */
.chx .action { left: auto; right: 30px; bottom: 56px; translate: 0 0; }
.chx .banner-row { top: 118px; }
.chx .banner { font-size: 40px; padding: 4px 40px 6px 40px; border-bottom-width: 9px; }

/* Salon : la colonne de droite ne comprime plus ses blocs (ils se chevauchaient), choix de chanson compact */
.lobby-right > * { flex-shrink: 0; }
.lobby-right > .grow { flex-shrink: 1; }
.lobby-options .rh-cover { display: none; }
.lobby-options .rh-pick-head .mode-name { font-size: 22px; }
.lobby-options .rh-pick-head .mode-desc { font-size: 15px; white-space: normal; }
.lobby-options .rh-list { height: 118px; }
.lobby-options .rh-pick-head { margin-bottom: 2px; }
.lobby-options .rh-song-name { font-size: 18px; }
/* Vignette d'un jeu sans illustration (en attendant l'image) : son nom */
.pick-name { font-size: 13px; white-space: normal; -unity-text-align: middle-center; color: #2E1B10; -unity-font-style: bold; flex-grow: 1; }
.lobby-art .pick-name { font-size: 22px; }
/* Aide en bas a droite : sur une pastille sombre, lisible sur la nappe comme sur l'herbe */
.hint { background-color: rgba(46, 27, 16, 0.62); border-radius: 14px; padding: 4px 14px; -unity-text-outline-width: 0; }
.lobby-options .rh-alt { display: none; }

/* Salon de taille fixe : colonne de droite compacte (fiche du jeu plus petite, options serrees) */
.lobby-cols { flex-grow: 1; }
.lobby-right .code { height: 70px; font-size: 50px; }
.lobby-game { margin: 8px 0 6px 0; padding: 6px 10px; }
.lobby-art { width: 120px; height: 66px; }
.lobby-game .mode-name { font-size: 24px; }
.lobby-options .mode-card { padding: 6px 10px; }
.lobby-themes .h2 { margin: 4px 0 2px 0; }

/* Petit bac : lettre et chrono en haut, panneau central (ecriture, vote, points) */
.bac-top { position: absolute; top: 24px; left: 0; right: 0; flex-direction: row; justify-content: center; align-items: center; }
.bac-letter {
    -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial; font-size: 84px; color: #FFFFFF; width: 130px; height: 130px;
    -unity-text-align: middle-center; background-color: #FF9B2F; border-radius: 65px; border-width: 6px; border-bottom-width: 12px; border-color: #2E1B10;
    -unity-text-outline-width: 4px; -unity-text-outline-color: #7A3300;
}
.bac-timer { font-size: 48px; -unity-font-style: bold; color: #FFFFFF; margin-left: 24px; -unity-text-outline-width: 3px; -unity-text-outline-color: #2E1B10; width: 90px; }
.bac-timer.hurry { color: #FF5A4A; }
.bac-panel { position: absolute; top: 175px; left: 50%; translate: -50% 0; width: 1080px; max-height: 820px; padding: 18px 30px 20px 30px; }
.bac-fields { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.bac-row { width: 49%; margin: 6px 0; }
.bac-cat { font-size: 22px; -unity-font-style: bold; color: #3B2416; margin: 0 0 2px 6px; }
.bac-field { height: 58px; margin: 0; }
.bac-field > .unity-base-text-field__input { font-size: 28px; border-radius: 14px; border-width: 3px; border-color: #2E1B10; background-color: #FFFDF6; padding: 0 14px; }
.bac-stop { align-self: center; margin-top: 12px; width: 360px; }
.bac-custom { margin: 8px 0 2px 0; }
.bac-custom > .unity-base-text-field__input { font-size: 20px; border-radius: 12px; border-width: 3px; border-color: #2E1B10; background-color: #FFFDF6; padding: 4px 12px; }
.bac-vote-list { height: 600px; }
.bac-vote-cat { font-size: 24px; -unity-font-style: bold; color: #3B2416; margin: 10px 0 4px 4px; }
.bac-vote-row { flex-wrap: wrap; }
Button.bac-word, Button.bac-word:hover, Button.bac-word:active {
    flex-direction: column; align-items: flex-start; margin: 3px 8px 3px 0; padding: 6px 14px; min-width: 150px;
    border-radius: 14px; border-width: 3px; border-color: #5CC23A; background-color: #EFFBE6;
}
Button.bac-word:hover { background-color: #FFF3D9; }
.bac-word.self { border-color: #9A8F8A; background-color: #F4EFE6; }
.bac-word.empty { border-color: #C9C0B2; background-color: #F4EFE6; opacity: 0.7; }
.bac-word.wrong, .bac-word.refused { border-color: #E5322D; background-color: #FDE3E0; }
.bac-word.mine-no { border-width: 5px; }
.bac-word-who { font-size: 15px; -unity-font-style: bold; }
.bac-word-text { font-size: 22px; color: #2E1B10; }
.bac-word-no { font-size: 15px; color: #E5322D; -unity-font-style: bold; }
.bac-score-row { flex-direction: row; align-items: center; margin-top: 10px; }
.bac-score-name { font-size: 28px; -unity-font-style: bold; width: 300px; }
.bac-score-gain { font-size: 30px; -unity-font-style: bold; color: #1C8A45; width: 120px; }
.bac-score-total { font-size: 24px; color: #3B2416; }
.bac-score-words { font-size: 17px; color: #6B5A4A; white-space: normal; margin-left: 4px; }

/* Petit bac : le bandeau passe en haut a droite de la lettre (le panneau occupe le centre) */
.bacx .banner-row { top: 50px; left: 1060px; right: auto; align-items: flex-start; }
.bacx .banner { font-size: 34px; padding: 4px 30px 6px 30px; border-bottom-width: 8px; }

/* Choix du jeu : grille de 3 colonnes, cartes horizontales (image a gauche, texte a droite) : plus de coupures */
.game-row { flex-wrap: wrap; justify-content: flex-start; align-items: flex-start; margin: 20px 0 16px 0; }
.game-card { flex-direction: row; width: 528px; height: 200px; flex-shrink: 0; margin: 0 8px 16px 8px; }
.game-art { width: 200px; height: auto; border-bottom-width: 0; border-right-width: 5px; justify-content: center; }
.game-art .pick-name { font-size: 26px; }
.game-txt { flex-grow: 1; flex-shrink: 1; padding: 12px 16px; justify-content: center; }
.game-card .mode-name, .game-card .mode-desc, .game-card .game-meta { -unity-text-align: upper-left; white-space: normal; }
.game-card .mode-name { font-size: 26px; }
.game-meta { font-size: 17px; margin: 2px 0 4px 0; }
.game-card .mode-desc { font-size: 16px; }

/* La Bonne Paye, facon jeu officiel : turquoise, jaune dore, bordures bleu marine */
.bp-top { position: absolute; top: 18px; left: 0; right: 0; flex-direction: row; justify-content: center; align-items: center; }
.bp-day { flex-direction: row; align-items: center; background-color: #FFFFFF; border-radius: 14px; border-width: 4px; border-bottom-width: 9px; border-color: #0D2B5C; padding: 4px 16px 4px 6px; margin-right: 26px; }
.bp-day-num { -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial; font-size: 46px; color: #FFFFFF; background-color: #E23A30; border-radius: 10px; width: 76px; height: 64px; -unity-text-align: middle-center; }
.bp-day-col { margin-left: 12px; }
.bp-day-name { -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial; font-size: 30px; color: #0D2B5C; }
.bp-day-month { font-size: 17px; -unity-font-style: bold; color: #3A6FB0; }
.bp-pot { align-items: center; justify-content: center; width: 190px; height: 118px; border-radius: 60px; background-color: #F7C315; border-width: 5px; border-bottom-width: 11px; border-color: #7A4A00; }
.bp-pot-title { -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial; font-size: 22px; color: #7A4A00; }
.bp-pot-value { -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial; font-size: 44px; color: #FFFFFF; -unity-text-outline-width: 3px; -unity-text-outline-color: #7A4A00; }
.bp-log { position: absolute; top: 22px; left: 24px; width: 520px; }
.bp-log-line { font-size: 16px; color: #FFFFFF; background-color: rgba(13, 43, 92, 0.78); border-radius: 10px; padding: 4px 12px; margin-bottom: 4px; white-space: normal; align-self: flex-start; }
.bp-players { position: absolute; bottom: 14px; left: 0; right: 0; flex-direction: row; justify-content: center; align-items: flex-end; }
.bp-player { width: 290px; margin: 0 6px; padding: 8px 12px 10px 12px; border-radius: 20px; border-width: 4px; border-bottom-width: 9px; border-color: #0D2B5C; background-color: #1AA3D4; transition-property: translate, scale; transition-duration: 0.2s; }
.bp-player.active { background-color: #F7C315; border-color: #7A4A00; translate: 0 -14px; }
.bp-player.done { opacity: 0.55; }
.bp-player-head { flex-direction: row; align-items: center; }
.bp-player-head .portrait { margin: 0; }
.bp-player-col { margin-left: 10px; flex-shrink: 1; }
.bp-name { -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial; font-size: 26px; color: #FFFFFF; -unity-text-outline-width: 2px; -unity-text-outline-color: #0D2B5C; }
.bp-player.active .bp-name { -unity-text-outline-color: #7A4A00; }
.bp-where { font-size: 15px; -unity-font-style: bold; color: #E8F7FF; }
.bp-player.active .bp-where { color: #7A4A00; }
.bp-money { -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial; font-size: 36px; color: #1C8A45; background-color: #FFFFFF; border-radius: 14px; margin-top: 6px; padding: 0 10px; -unity-text-align: middle-center; }
.bp-badges { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
.bp-badge { font-size: 13px; -unity-font-style: bold; color: #FFFFFF; border-radius: 8px; padding: 1px 7px; margin: 3px 4px 0 0; }
.bp-badge.save { background-color: #1C8A45; } .bp-badge.loan { background-color: #E23A30; } .bp-badge.bill { background-color: #B23A8A; }
.bp-badge.acq { background-color: #2E7D32; } .bp-badge.mail { background-color: #C0392B; } .bp-badge.ins { background-color: #0D2B5C; } .bp-badge.need { background-color: #D9660C; }
.bp-center { position: absolute; top: 215px; left: 0; right: 0; align-items: center; opacity: 0; scale: 0.85 0.85; transition-property: opacity, scale; transition-duration: 0.22s; }
.bp-center.show { opacity: 1; scale: 1 1; }
.bp-card-img { width: 620px; height: 394px; -unity-background-scale-mode: scale-to-fit; }
.bp-prompt { font-size: 24px; -unity-font-style: bold; color: #FFFFFF; background-color: rgba(13, 43, 92, 0.92); border-radius: 16px; padding: 10px 22px; margin-top: 10px; max-width: 900px; white-space: normal; -unity-text-align: middle-center; }
.bp-actions { justify-content: center; flex-wrap: wrap; margin-top: 10px; max-width: 1000px; }
.bp-actions > Button { margin: 4px 8px; }
.bp-turn { position: absolute; bottom: 230px; left: 0; right: 0; flex-direction: row; justify-content: center; align-items: center; }
.bp-turn > Button { margin: 0 10px; }
.bp-bank { position: absolute; bottom: 330px; left: 50%; translate: -50% 0; background-color: #FFFFFF; border-radius: 22px; border-width: 4px; border-bottom-width: 9px; border-color: #0D2B5C; padding: 12px 18px; align-items: center; }
.bp-bank-title { font-size: 17px; -unity-font-style: bold; color: #0D2B5C; margin: 2px 0 4px 0; }
.bp-bank-row { justify-content: center; flex-wrap: wrap; }
.bp-bank-row > Button { margin: 3px 6px; }
.bpx .banner-row { top: 145px; }
.bpx .banner { font-size: 38px; padding: 4px 36px 6px 36px; border-bottom-width: 9px; }
.bp-turn-label { font-size: 26px; -unity-font-style: bold; color: #FFFFFF; background-color: rgba(13, 43, 92, 0.9); border-radius: 16px; padding: 8px 20px; margin-right: 10px; }

/* Bonne Paye, vue de dessus : etiquettes des joueurs a cote de leur coin de table, decisions en bas */
.bp .bp-players { position: absolute; left: 0; top: 0; right: 0; bottom: 0; bottom: auto; }
.bp .bp-player { position: absolute; width: 250px; margin: 0; padding: 6px 10px 8px 10px; border-radius: 16px; border-bottom-width: 7px; }
.bp .bp-player.active { translate: 0 -8px; }
.bp .bp-name { font-size: 22px; }
.bp .bp-where { font-size: 13px; }
.bp .bp-money { font-size: 28px; margin-top: 3px; border-radius: 10px; }
.bp .bp-center { top: auto; bottom: 16px; }
.bp .bp-turn { bottom: 16px; }
.bp .bp-bank { bottom: 96px; }
/* Fil de la partie : en bas a gauche, sous les coins de table (plus rien en haut sous le bandeau) */
.bp .bp-log { top: auto; bottom: 16px; left: 16px; right: auto; width: 460px; align-items: flex-start; }
.bp .bp-log-line { align-self: flex-start; font-size: 15px; padding: 3px 12px; }
.bp-months-row { justify-content: center; align-items: center; margin: 8px 0; }
.bp-months-value { font-size: 40px; -unity-font: url("../Fonts/LilitaOne.ttf"); -unity-font-definition: initial; color: #2E1B10; margin: 0 22px; min-width: 150px; -unity-text-align: middle-center; }

Button.gl.bp-step { width: 80px; }
Button.gl.bp-step .gl-label { font-size: 40px; }
/* Choix du jeu : 4 colonnes (11 jeux et plus tiennent sans deborder sur le bouton Retour) */
.game-card { width: 392px; height: 176px; margin: 0 5px 12px 5px; }
.game-art { width: 150px; }
.game-art .pick-name { font-size: 22px; }
.game-txt { padding: 8px 12px; }
.game-card .mode-name { font-size: 22px; }
.game-meta { font-size: 15px; }
.game-card .mode-desc { font-size: 14px; }
.bp-rotate { position: absolute; right: 24px; bottom: 16px; }
.bp-rotate > Button { margin-left: 10px; }

/* Pouilleux : ma main (cartes classiques), le valet de pique legerement teinte */
.pq-card { width: 150px; height: 213px; border-radius: 10px; }
.pq-hand { bottom: -40px; }
.pq-status { bottom: 230px; }
.pq-target { border-color: rgb(255, 196, 40); border-width: 5px; scale: 1.12 1.12; background-color: rgb(255, 244, 205); }
.pq-new { translate: 0 -46px; }
.pq-new > .pq-card { border-color: rgb(255, 196, 40); border-width: 6px; }
.pqx .banner-row { top: 455px; }
.pqx .banner { font-size: 40px; padding: 4px 40px 6px 40px; border-bottom-width: 9px; }
