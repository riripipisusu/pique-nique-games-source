.root {
    flex-grow: 1;
    -unity-font: url("../Fonts/Fredoka.ttf");
    -unity-font-definition: initial;
    color: rgb(74, 46, 23);
}

.screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    opacity: 0;
    translate: 0 24px;
    transition-property: opacity, translate;
    transition-duration: 0.3s, 0.3s;
    transition-timing-function: ease-out-cubic;
}
.screen.in { opacity: 1; translate: 0 0; }
.hidden { display: none; }
.dim { background-color: rgba(20, 30, 20, 0.55); }

/* ---------- Ecran titre ---------- */
.title-screen { justify-content: flex-start; padding-top: 90px; }
.logo {
    font-size: 128px;
    -unity-font-style: bold;
    color: rgb(255, 170, 60);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(91, 58, 34);
    text-shadow: 0 10px 0 rgb(91, 58, 34);
    -unity-text-align: middle-center;
}
.tagline {
    font-size: 34px;
    color: rgb(255, 255, 255);
    text-shadow: 0 3px 6px rgba(0, 0, 0, 0.6);
    margin-bottom: 60px;
    -unity-text-align: middle-center;
}
.menu-col { align-items: stretch; width: 460px; }
.credits {
    position: absolute; bottom: 18px; right: 26px;
    font-size: 18px; color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6);
}

/* ---------- Boutons ---------- */
Button.btn {
    font-size: 36px;
    height: 86px;
    margin: 10px 0;
    padding: 0 30px;
    border-radius: 24px;
    background-color: rgb(240, 138, 36);
    color: rgb(255, 255, 255);
    border-width: 4px;
    border-bottom-width: 11px;
    border-color: rgb(91, 58, 34);
    -unity-font-style: bold;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(140, 70, 10);
    transition-property: scale, background-color, translate, border-bottom-width;
    transition-duration: 0.12s;
}
Button.btn:hover { scale: 1.04 1.04; background-color: rgb(255, 160, 60); }
Button.btn:active { translate: 0 6px; border-bottom-width: 5px; }
Button.btn:disabled { opacity: 0.45; }
Button.btn.green { background-color: rgb(110, 190, 75); -unity-text-outline-color: rgb(50, 110, 30); }
Button.btn.green:hover { background-color: rgb(130, 210, 90); }
Button.btn.ghost { background-color: rgb(236, 219, 186); color: rgb(91, 58, 34); -unity-text-outline-width: 0; }
Button.btn.ghost:hover { background-color: rgb(248, 234, 205); }
Button.btn.small { font-size: 26px; height: 62px; border-bottom-width: 8px; border-radius: 18px; }
Button.btn.round { width: 76px; height: 76px; padding: 0; border-radius: 38px; font-size: 30px; }

/* ---------- Panneaux ---------- */
.panel {
    background-color: rgb(255, 247, 229);
    border-radius: 30px;
    border-width: 5px;
    border-bottom-width: 13px;
    border-color: rgb(91, 58, 34);
    padding: 34px 44px;
}
.panel-title {
    font-size: 58px;
    -unity-font-style: bold;
    color: rgb(240, 138, 36);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(91, 58, 34);
    margin-bottom: 18px;
    -unity-text-align: middle-center;
}
.h2 { font-size: 32px; -unity-font-style: bold; margin: 16px 0 8px 0; }
.p { font-size: 25px; white-space: normal; margin-bottom: 8px; }
.row { flex-direction: row; align-items: center; }
.spread { justify-content: space-between; }
.grow { flex-grow: 1; }

/* ---------- Nouvelle partie ---------- */
.mode-card {
    flex-grow: 1; flex-basis: 0;
    height: 190px;
    margin: 0 10px;
    padding: 18px 22px;
    border-radius: 22px;
    border-width: 4px;
    border-bottom-width: 9px;
    border-color: rgb(190, 160, 120);
    background-color: rgb(250, 238, 212);
    align-items: flex-start;
    justify-content: flex-start;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.15s;
}
.mode-card:hover { scale: 1.02 1.02; }
.mode-card.selected { border-color: rgb(240, 138, 36); background-color: rgb(255, 229, 190); }
.mode-name { font-size: 36px; -unity-font-style: bold; }
.mode-desc { font-size: 21px; white-space: normal; color: rgb(110, 80, 50); margin-top: 6px; }

.player-row { flex-direction: row; align-items: center; margin: 6px 0; }
.chip { width: 44px; height: 44px; border-radius: 22px; border-width: 4px; border-color: rgb(91, 58, 34); margin-right: 14px; }
TextField.name-field { flex-grow: 1; margin: 0; }
TextField.name-field > .unity-text-field__input {
    font-size: 28px; height: 58px; padding: 0 16px;
    border-radius: 16px; border-width: 3px; border-color: rgb(190, 160, 120);
    background-color: rgb(255, 255, 255); color: rgb(74, 46, 23);
}
TextField.name-field:focus > .unity-text-field__input { border-color: rgb(240, 138, 36); }

/* ---------- Parametres ---------- */
.settings-panel { width: 1240px; height: 860px; }
.tabs { flex-direction: row; justify-content: center; margin-bottom: 14px; }
Button.tab {
    font-size: 27px; height: 58px; margin: 0 6px; padding: 0 26px;
    border-radius: 18px; border-width: 3px; border-color: rgb(190, 160, 120);
    background-color: rgb(245, 230, 200); color: rgb(110, 80, 50);
}
Button.tab:hover { background-color: rgb(252, 240, 215); }
Button.tab.selected { background-color: rgb(240, 138, 36); border-color: rgb(91, 58, 34); color: rgb(255, 255, 255); -unity-font-style: bold; }
.settings-scroll { flex-grow: 1; margin-bottom: 14px; }
.setting {
    flex-direction: row; align-items: center; justify-content: space-between;
    height: 72px; padding: 0 22px; margin: 4px 0;
    border-radius: 16px; background-color: rgb(250, 238, 212);
}
.setting-label { font-size: 27px; }
.setting-field { width: 470px; margin: 0; }
.value { font-size: 24px; width: 80px; -unity-text-align: middle-right; }

DropdownField > .unity-base-popup-field__input,
.unity-base-dropdown__container-outer {
    font-size: 24px; height: 50px; padding: 0 14px;
    border-radius: 14px; border-width: 3px; border-color: rgb(190, 160, 120);
    background-color: rgb(255, 255, 255); color: rgb(74, 46, 23);
}
.unity-base-dropdown__label { font-size: 24px; }
.unity-base-dropdown__item { height: 42px; }

Slider { flex-grow: 1; margin: 0; }
Slider .unity-base-slider__tracker {
    height: 12px; margin-top: -6px; border-radius: 6px;
    background-color: rgb(225, 205, 170); border-width: 0;
}
Slider .unity-base-slider__dragger {
    width: 34px; height: 34px; margin-top: -17px; border-radius: 17px;
    background-color: rgb(240, 138, 36); border-width: 4px; border-color: rgb(91, 58, 34);
}
Toggle .unity-toggle__checkmark {
    width: 44px; height: 44px; border-radius: 12px;
    border-width: 4px; border-color: rgb(91, 58, 34);
    background-color: rgb(255, 255, 255);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
Toggle:checked .unity-toggle__checkmark { background-color: rgb(110, 190, 75); }

/* ---------- HUD ---------- */
.hud { justify-content: flex-start; align-items: stretch; }
.players-bar { flex-direction: row; justify-content: center; margin-top: 18px; }
.pcard {
    flex-direction: row; align-items: center;
    margin: 0 8px; padding: 10px 18px 10px 12px;
    border-radius: 20px; border-width: 4px; border-bottom-width: 9px; border-color: rgb(91, 58, 34);
    background-color: rgb(255, 247, 229);
    transition-property: scale, translate; transition-duration: 0.25s;
}
.pcard.active { scale: 1.1 1.1; translate: 0 6px; border-color: rgb(240, 138, 36); }
.pname { font-size: 26px; -unity-font-style: bold; margin: 0 12px 0 10px; }
.pip {
    width: 34px; height: 34px; margin: 0 3px; border-radius: 17px; border-width: 3px;
    border-color: rgb(91, 58, 34); background-color: rgb(225, 210, 185);
    font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(74, 46, 23);
}
.pip.field { background-color: rgb(255, 255, 255); }

.pause-btn { position: absolute; top: 18px; right: 22px; }

.action {
    position: absolute; bottom: 20px; left: 50%; translate: -50% 0;
    flex-direction: row; align-items: center;
    padding: 12px 24px 14px 18px;
}
.action-col { align-items: center; }
.turn { font-size: 28px; -unity-text-align: middle-center; margin-bottom: 2px; }
.card {
    width: 100px; height: 134px; margin: 0 20px 0 0;
    border-radius: 16px; border-width: 4px; border-bottom-width: 8px; border-color: rgb(91, 58, 34);
    background-color: rgb(255, 255, 255);
    align-items: center; justify-content: center;
    scale: 1 1; rotate: 0deg;
    transition-property: scale, rotate; transition-duration: 0.35s; transition-timing-function: ease-out-back;
}
.card.flip { scale: 0 1; rotate: -8deg; }
.card.carrot-card { background-color: rgb(255, 214, 160); }
.card-value { font-size: 66px; -unity-font-style: bold; color: rgb(240, 138, 36); -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(91, 58, 34); }
.card.carrot-card .card-value { font-size: 22px; -unity-text-align: middle-center; }
.card-sub { font-size: 15px; color: rgb(110, 80, 50); -unity-text-align: middle-center; white-space: normal; }
.rabbit-row { flex-direction: row; justify-content: center; }
.rabbit-row Button.btn { width: 170px; margin: 4px 6px; white-space: normal; font-size: 21px; height: 72px; border-bottom-width: 7px; }
.deck { font-size: 17px; color: rgb(140, 110, 80); margin-top: 2px; }

.feed { position: absolute; bottom: 26px; left: 26px; width: 520px; padding: 18px 24px; }
.feed-line { font-size: 21px; white-space: normal; margin: 2px 0; color: rgb(110, 80, 50); }
.feed-line.last { color: rgb(74, 46, 23); -unity-font-style: bold; }

.cycle { position: absolute; top: 120px; right: 26px; width: 420px; padding: 20px 24px; }
.cycle-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 6px; }
.cell {
    width: 66px; height: 58px; margin: 3px; border-radius: 12px; border-width: 3px;
    border-color: rgb(190, 160, 120); background-color: rgb(245, 230, 200);
    font-size: 24px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(160, 130, 100);
}
.cell.known { background-color: rgb(255, 255, 255); color: rgb(74, 46, 23); }
.cell.next { border-color: rgb(230, 60, 45); background-color: rgb(255, 200, 190); color: rgb(160, 30, 20); }
.cell.now { border-color: rgb(91, 58, 34); background-color: rgb(240, 138, 36); color: rgb(255, 255, 255); }
.small-note { font-size: 19px; color: rgb(140, 110, 80); white-space: normal; margin-top: 8px; }

.banner {
    position: absolute; top: 150px; left: 0; right: 0;
    font-size: 64px; -unity-font-style: bold; -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(91, 58, 34);
    text-shadow: 0 6px 0 rgb(91, 58, 34);
    opacity: 0; scale: 0.6 0.6;
    transition-property: opacity, scale; transition-duration: 0.3s; transition-timing-function: ease-out-back;
}
.banner.show { opacity: 1; scale: 1 1; }
.hint {
    position: absolute; bottom: 12px; right: 26px; font-size: 19px;
    color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(60, 40, 20);
}

.win-title { font-size: 90px; }

.code { font-size: 60px; -unity-font-style: bold; color: rgb(240, 138, 36); letter-spacing: 8px; margin-left: 14px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(91, 58, 34); }
.status { color: rgb(200, 90, 30); min-height: 34px; margin-top: 10px; }

/* ---------- Multi-jeux ---------- */
.layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.game-card {
    flex-grow: 1; flex-basis: 0; height: 430px; margin: 0 12px; padding: 0 0 20px 0;
    border-radius: 26px; border-width: 5px; border-bottom-width: 12px; border-color: rgb(91, 58, 34);
    background-color: rgb(250, 238, 212); align-items: stretch; justify-content: flex-start; overflow: hidden;
    transition-property: scale, translate; transition-duration: 0.15s;
}
.game-card:hover { scale: 1.03 1.03; translate: 0 -6px; }
.game-card .mode-name, .game-card .game-meta, .game-card .mode-desc { margin-left: 24px; margin-right: 24px; }
.game-card .mode-name { font-size: 44px; margin-top: 14px; }
.game-art { height: 190px; margin-bottom: 4px; }
.game-croque .game-art { background-color: rgb(95, 158, 60); border-bottom-width: 12px; border-color: rgb(240, 138, 36); }
.game-bj .game-art { background-color: rgb(31, 107, 62); border-bottom-width: 12px; border-color: rgb(122, 74, 38); }
.game-meta { font-size: 21px; color: rgb(240, 138, 36); -unity-font-style: bold; }

.portrait {
    border-radius: 50%; border-width: 4px; border-color: rgb(91, 58, 34);
    background-color: rgb(214, 234, 248); -unity-background-scale-mode: scale-and-crop;
    padding: 0; margin: 0 10px 0 0;
}
Button.portrait:hover { scale: 1.08 1.08; border-color: rgb(240, 138, 36); }
.avatar-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.avatar-cell { width: 160px; align-items: center; margin: 8px 4px; }
.avatar-cell .portrait { margin: 0; }
.avatar-name { font-size: 17px; -unity-text-align: middle-center; white-space: normal; margin-top: 4px; }

.chips { font-size: 22px; -unity-font-style: bold; color: rgb(31, 107, 62); padding: 4px 12px; border-radius: 14px; background-color: rgb(226, 243, 214); }
.chips.broke { color: rgb(160, 60, 40); background-color: rgb(250, 220, 210); }
.round-label {
    position: absolute; top: 108px; left: 0; right: 0; -unity-text-align: middle-center;
    font-size: 30px; -unity-font-style: bold; color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(60, 40, 20);
}
.bet-label { font-size: 30px; -unity-font-style: bold; color: rgb(240, 138, 36); }
Button.chip-btn { width: 96px; height: 96px; border-radius: 48px; padding: 0; font-size: 24px; margin: 4px 6px; border-width: 6px; border-color: rgb(255, 255, 255); }
Button.chip-10 { background-color: rgb(216, 66, 58); }
Button.chip-50 { background-color: rgb(47, 111, 214); }
Button.chip-100 { background-color: rgb(43, 43, 43); }
Button.chip-500 { background-color: rgb(138, 79, 208); }
.bubbles { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.bubble {
    position: absolute; translate: -50% -100%;
    font-size: 22px; -unity-font-style: bold; padding: 4px 14px; border-radius: 16px;
    background-color: rgba(255, 247, 229, 0.95); color: rgb(74, 46, 23);
    border-width: 2px; border-bottom-width: 5px; border-color: rgb(91, 58, 34);
}

/* ---------- Blackjack façon casino ---------- */
.bj-turn {
    position: absolute; top: 24px; left: 0; right: 0; -unity-text-align: middle-center;
    font-size: 34px; -unity-font-style: bold; color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(20, 12, 8);
}
.bj-side { position: absolute; bottom: 110px; flex-direction: column-reverse; align-items: center; }
.bj-side.left { left: 40px; }
.bj-side.right { right: 40px; }
.round-action { align-items: center; margin: 10px 0; }
Button.round-act {
    width: 118px; height: 118px; border-radius: 59px; padding: 0; margin: 0;
    font-size: 44px; border-width: 6px; border-bottom-width: 6px; border-color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);
}
Button.round-act.act-red { background-color: rgb(214, 48, 49); }
Button.round-act.act-green { background-color: rgb(76, 175, 80); }
Button.round-act.act-blue { background-color: rgb(52, 120, 200); }
Button.round-act:hover { scale: 1.08 1.08; }
Button.round-act:disabled { opacity: 0.35; }
.round-label-txt {
    font-size: 20px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-top: 4px;
    -unity-text-outline-width: 1.5px; -unity-text-outline-color: rgb(0, 0, 0);
}
.bj-bet {
    position: absolute; bottom: 90px; left: 50%; translate: -50% 0; align-items: center;
    padding: 12px 26px; border-radius: 26px; background-color: rgba(10, 20, 14, 0.78);
    border-width: 3px; border-color: rgb(217, 178, 90);
}
.bj-bet .bet-label { color: rgb(255, 222, 140); }
Button.chip-btn {
    width: 92px; height: 92px; border-radius: 46px; padding: 0; margin: 4px 6px;
    border-width: 0; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit;
}
Button.chip-btn:hover { scale: 1.12 1.12; translate: 0 -4px; }
.bj-bar {
    position: absolute; bottom: 0; left: 0; right: 0; height: 64px;
    flex-direction: row; justify-content: space-around; align-items: center;
    background-color: rgba(8, 6, 5, 0.85); border-top-width: 2px; border-color: rgb(217, 178, 90);
}
.bar-item { font-size: 26px; color: rgb(240, 225, 190); }
.seat-tag {
    position: absolute; translate: -50% 0; flex-direction: row; align-items: center;
    padding: 6px 16px 6px 6px; border-radius: 40px; background-color: rgba(10, 8, 6, 0.8);
    border-width: 2px; border-color: rgb(217, 178, 90);
}
.seat-tag.active { border-color: rgb(255, 240, 150); scale: 1.08 1.08; background-color: rgba(60, 45, 10, 0.9); }
.seat-tag .portrait { margin-right: 10px; }
.seat-name { font-size: 20px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.seat-chips { font-size: 20px; color: rgb(255, 214, 120); }
.bubble.badge {
    background-color: rgba(15, 15, 15, 0.88); color: rgb(255, 255, 255);
    border-width: 0; border-bottom-width: 4px; border-radius: 10px; font-size: 24px; padding: 2px 12px;
}

/* Accueil : menu a gauche, le pique-nique reste visible */
.title-screen { align-items: flex-start; padding-left: 110px; padding-top: 70px; }
.title-screen .logo { font-size: 104px; -unity-text-align: middle-left; }
.title-screen .tagline { -unity-text-align: middle-left; margin-left: 8px; }

Button.btn.chip-btn, Button.btn.chip-btn:active, Button.btn.chip-btn:hover {
    border-width: 0; border-bottom-width: 0; background-color: rgba(0, 0, 0, 0);
}
.bj-bet { left: auto; right: 34px; bottom: 90px; translate: 0 0; width: 250px; }
.bj-bet .rabbit-row { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.bj-bet Button.btn.small { width: 200px; margin: 6px 0; }

.update-card { position: absolute; top: 40px; right: 40px; width: 420px; align-items: center; padding: 20px 26px; }
.update-card .p { -unity-text-align: middle-center; }

/* --- Roulette --------------------------------------------------------------------- */
.game-rt .game-art { background-color: rgb(120, 22, 30); border-bottom-width: 12px; border-color: rgb(217, 178, 90); }
.rt-panel {
    position: absolute; bottom: 18px; left: 50%; translate: -50% 0; align-items: center;
    padding: 12px 22px 14px 22px; border-radius: 26px; background-color: rgba(10, 20, 14, 0.86);
    border-width: 3px; border-color: rgb(217, 178, 90);
}
.rt-panel > .row.spread { width: 100%; margin-bottom: 6px; align-items: center; }
.rt-info { font-size: 24px; color: rgb(240, 225, 190); margin-right: 20px; }
Button.chip-btn.rt-chipbtn { width: 62px; height: 62px; border-radius: 31px; margin: 0 4px; }
Button.chip-btn.rt-chipbtn.rt-sel { scale: 1.18 1.18; translate: 0 -6px; }
.rt-board { position: relative; margin: 6px 0 8px 0; }
.rt-cell {
    position: absolute; align-items: center; justify-content: center;
    border-width: 1.5px; border-color: rgb(240, 225, 190); background-color: rgb(24, 98, 52);
}
.rt-cell.red { background-color: rgb(190, 32, 36); }
.rt-cell.black { background-color: rgb(26, 24, 24); }
.rt-cell.green { background-color: rgb(24, 128, 60); border-top-left-radius: 26px; border-bottom-left-radius: 26px; }
.rt-cell.red-chance { background-color: rgb(24, 98, 52); background-image: none; }
.rt-cell.red-chance > .rt-num, .rt-cell.black-chance > .rt-num { width: 34px; height: 34px; rotate: 45deg; }
.rt-cell.red-chance > .rt-num { background-color: rgb(190, 32, 36); }
.rt-cell.black-chance > .rt-num { background-color: rgb(26, 24, 24); }
.rt-cell.hl { border-color: rgb(255, 222, 120); border-width: 3px; background-color: rgb(214, 160, 40); }
.rt-cell:hover { border-color: rgb(255, 222, 120); }
.rt-num { font-size: 22px; -unity-font-style: bold; color: rgb(255, 250, 235); -unity-text-align: middle-center; }
.rt-spot { position: absolute; width: 18px; height: 18px; border-radius: 9px; background-color: rgba(255, 255, 255, 0); }
.rt-spot:hover { background-color: rgba(255, 222, 120, 0.9); }
.rt-chip {
    position: absolute; width: 34px; height: 34px; border-radius: 17px; -unity-text-align: middle-center;
    font-size: 14px; -unity-font-style: bold; color: rgb(40, 24, 10); background-color: rgb(255, 214, 90);
    border-width: 3px; border-color: rgb(255, 255, 255);
}
.rt-prison { font-size: 20px; color: rgb(255, 180, 120); margin-bottom: 4px; }
.rt-panel Button.btn.small { width: 190px; margin: 0 8px; }
.rt-players { position: absolute; top: 110px; left: 24px; }
.rt-player {
    flex-direction: row; align-items: center; margin-bottom: 10px; padding: 6px 18px 6px 6px;
    border-radius: 36px; background-color: rgba(10, 8, 6, 0.8); border-width: 2px; border-color: rgb(217, 178, 90);
}
.rt-player.active { border-color: rgb(255, 240, 150); background-color: rgba(60, 45, 10, 0.9); scale: 1.05 1.05; }
.rt-history { position: absolute; top: 110px; right: 30px; flex-direction: column; align-items: center; }
.rt-hist {
    width: 50px; height: 50px; border-radius: 25px; margin-bottom: 6px; -unity-text-align: middle-center;
    font-size: 22px; -unity-font-style: bold; color: rgb(255, 250, 235); border-width: 2px; border-color: rgb(217, 178, 90);
}
.rt-hist.red { background-color: rgb(190, 32, 36); }
.rt-hist.black { background-color: rgb(26, 24, 24); }
.rt-hist.green { background-color: rgb(24, 128, 60); }
